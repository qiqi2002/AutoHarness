{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoharness.local/schemas/tools/webwalk-planner-action.schema.json",
  "title": "WebWalk Planner Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "open_url",
        "open_link",
        "final"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "link_id": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "open_url"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "url"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "link_id"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "open_link"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "link_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "final"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "link_id"
              ]
            }
          ]
        }
      }
    }
  ]
}
