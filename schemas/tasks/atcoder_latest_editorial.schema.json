{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoharness.local/schemas/tasks/atcoder_latest_editorial.schema.json",
  "title": "AtCoder Latest Editorial Demo Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contest_id",
    "contest_title",
    "contest_url",
    "editorial_url",
    "problems",
    "evidence",
    "webwalk_trace"
  ],
  "properties": {
    "contest_id": {
      "type": "string",
      "minLength": 1
    },
    "contest_title": {
      "type": "string",
      "minLength": 1
    },
    "contest_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_url": {
      "type": "string",
      "format": "uri"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "title",
          "editorial_url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "editorial_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "reason"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "webwalk_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
