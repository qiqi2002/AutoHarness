{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoharness.local/schemas/tasks/atcoder_problem_editorial.schema.json",
  "title": "AtCoder Problem Editorial Demo Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contest_id",
    "problem_id",
    "problem_title",
    "problem_url",
    "editorial_index_url",
    "editorial_url",
    "editorial_title",
    "editorial_text_excerpt",
    "evidence",
    "webwalk_trace"
  ],
  "properties": {
    "contest_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_title": {
      "type": "string",
      "minLength": 1
    },
    "problem_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_index_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_title": {
      "type": "string"
    },
    "editorial_text_excerpt": {
      "type": "string",
      "minLength": 1
    },
    "selection_strategy": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "reason"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "webwalk_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
