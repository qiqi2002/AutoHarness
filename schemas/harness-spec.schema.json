{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoharness.local/schemas/harness-spec.schema.json",
  "title": "AutoHarness Harness Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_id",
    "name",
    "description",
    "task",
    "agents",
    "tools",
    "workflow",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "harness_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "inputs",
        "output_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "prompt",
          "io_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "io_schema": {
            "type": "object"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "config"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/dispatch_step"
          },
          {
            "$ref": "#/$defs/accept_step"
          },
          {
            "$ref": "#/$defs/finish_step"
          }
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "summary",
        "nodes",
        "edges",
        "success_criteria",
        "divergence_policy"
      ],
      "properties": {
        "representation": {
          "type": "string",
          "enum": [
            "sequence",
            "graph"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plan_node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_edge"
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "divergence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detect_with",
            "on_divergence"
          ],
          "properties": {
            "detect_with": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "on_divergence": {
              "type": "string",
              "enum": [
                "revise_plan",
                "reject_output",
                "fail_run"
              ]
            }
          }
        }
      }
    },
    "plan_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "description",
        "workflow_step_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "observe",
            "decide",
            "extract",
            "verify",
            "finish"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workflow_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dispatch_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "target_agent_name",
        "input_source"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "dispatch"
        },
        "target_agent_name": {
          "type": "string",
          "minLength": 1
        },
        "input_source": {
          "$ref": "#/$defs/input_source"
        }
      }
    },
    "accept_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "decision",
        "reason"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "accept_output"
        },
        "decision": {
          "type": "string",
          "enum": [
            "Accept",
            "Reject"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finish_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "summary"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "finish"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ],
          "properties": {
            "type": {
              "const": "variable"
            },
            "data": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ],
          "properties": {
            "type": {
              "const": "tool"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool_name",
                "arguments"
              ],
              "properties": {
                "tool_name": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  }
}
